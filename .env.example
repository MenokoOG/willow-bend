# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Firebase (Vite-exposed, used by the client SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Admin allowlist (comma-separated emails). Gates the admin UI only —
# the Firestore security rules must list the same emails in isAdminEmail()
# for admin access to actually work. Set this in Netlify's env vars too.
# Note: VITE_ vars are baked into the client bundle at build time, so
# these emails are visible in the deployed JS (just not in the repo).
VITE_ADMIN_EMAILS=

# EmailJS (contact form)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# OpenAI (Willow AI, server-side only — used by netlify/functions/willow.ts).
# The real key lives only in .env (gitignored). Never commit it.
# Deliberately NOT VITE_-prefixed so it can never reach the client bundle.
# Without a key, Willow falls back to the offline keyword engine automatically.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
WILLOW_MODEL=
